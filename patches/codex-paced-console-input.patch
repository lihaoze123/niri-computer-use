+/// Console viewers forward keystrokes to another machine. Give their event loop time to
+/// process each complete character rather than sending the whole text in one Wayland burst.
+/// Sleep in this client, never in the compositor's event loop. Do not replay partial input.
+pub async fn type_text(
+    window_id: u64,
+    value: &str,
+    ctrl_shift_u: bool,
+    paced: bool,
+) -> Result<()> {
+    if !paced {
+        return input(window_id, vec![text(value, ctrl_shift_u)]).await;
+    }
+    for ch in value.chars() {
+        input(window_id, vec![text(&ch.to_string(), ctrl_shift_u)]).await?;
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+    Ok(())
+}
